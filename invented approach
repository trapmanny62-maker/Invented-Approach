      function setLanguage(lang) {
        document.querySelectorAll('[data-key]').forEach(el => {
          const key = el.getAttribute('data-key');
          if (translations[lang] && translations[lang][key] !== undefined) {
            if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
              el.placeholder = translations[lang][key];
            } else {
              el.textContent = translations[lang][key];
            }
          }
        });
        document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
        document.querySelector(`.lang-btn[data-lang="${lang}"]`).classList.add('active');
      }

      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          setLanguage(btn.dataset.lang);
        });
      });

      // ─── HAMBURGER ───
      const hamburger = document.getElementById('hamburger');
      const navLinks = document.getElementById('navLinks');
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('open');
        navLinks.classList.toggle('open');
      });
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('open');
          navLinks.classList.remove('open');
        });
      });

      // ─── HEADER SCROLL ───
      const header = document.getElementById('header');
      window.addEventListener('scroll', () => {
        header.classList.toggle('scrolled', window.scrollY > 40);
      });

      // ─── ACTIVE NAV LINK ───
      const sections = document.querySelectorAll('section[id]');
      const navItems = navLinks.querySelectorAll('a');
      window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(section => {
          const top = section.offsetTop - 120;
          if (window.scrollY >= top) current = section.getAttribute('id');
        });
        navItems.forEach(link => {
          link.classList.toggle('active', link.getAttribute('href') === '#' + current);
        });
      });

      // ─── REVIEWS ───
      const STORAGE_KEY = 'invented_approach_reviews';
      const reviewsGrid = document.getElementById('reviewsGrid');
      const defaultReviews = [
        { stars:5, name:'Sarah M.', role:'Architect · Owner of 6 units', comment:'“The customer care is awesome, they are really quick to reply and always active whenever i call”' },
        { stars:5, name:'David K.', role:'Business Traveler, Kenya', comment:'“Ever since i partnered with Invented Approach, my business has been really smooth and there has been a massive increase in my customer base.”' },
        { stars:5, name:'Sam', role:'Tourist · Gorilla Trek', comment:'"I really love Rwanda it\'s a great country and i love the services of the company, the paid advertising has really boosted my social media audience and i\'ve been seeing a lot engagements in my business”' }
      ];

      function loadReviews() {
        let reviews = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (!reviews || reviews.length === 0) {
          reviews = defaultReviews;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
        }
        renderReviews(reviews);
      }

      function renderReviews(reviews) {
        reviewsGrid.innerHTML = '';
        reviews.forEach(review => {
          const stars = '★'.repeat(review.stars) + '☆'.repeat(5 - review.stars);
          const card = document.createElement('div');
          card.className = 'review-card';
          card.innerHTML = `
            <div class="review-stars">${stars}</div>
            <blockquote>${review.comment}</blockquote>
            <div class="review-author">
              <div class="avatar">${review.name.charAt(0).toUpperCase()}</div>
              <div>
                <div class="name">${review.name}</div>
                <div class="role">${review.role || review.stars + ' ★'}</div>
              </div>
            </div>
          `;
          reviewsGrid.appendChild(card);
        });
      }

      function addReview(name, comment, rating) {
        const reviews = JSON.parse(localStorage.getItem(STORAGE_KEY)) || defaultReviews;
        const newReview = {
          stars: parseInt(rating),
          name: name.trim(),
          role: rating + ' ★ · Just now',
          comment: '“' + comment.trim() + '”'
        };
        reviews.unshift(newReview);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
        renderReviews(reviews);
      }

      loadReviews();

      const reviewForm = document.getElementById('reviewForm');
      const reviewFeedback = document.getElementById('reviewFeedback');
      reviewForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('reviewName').value.trim();
        const comment = document.getElementById('reviewComment').value.trim();
        const rating = document.querySelector('input[name="rating"]:checked');
        if (!name || !comment || !rating) {
          reviewFeedback.textContent = 'Please fill in all fields and select a star rating.';
          reviewFeedback.style.color = '#e74c3c';
          return;
        }
        addReview(name, comment, rating.value);
        reviewFeedback.textContent = '✅ Review submitted successfully!';
        reviewFeedback.style.color = 'var(--primary)';
        reviewForm.reset();
        setTimeout(() => { reviewFeedback.textContent = ''; }, 4000);
      });

      // ─── EXPLORE MORE TOGGLE ───
      const exploreToggle = document.getElementById('exploreToggle');
      const exploreSection = document.getElementById('exploreSection');
      const exploreClose = document.getElementById('exploreClose');

      function showExplore() {
        exploreSection.classList.add('visible');
        exploreSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function hideExplore() {
        exploreSection.classList.remove('visible');
      }

      exploreToggle.addEventListener('click', showExplore);
      exploreClose.addEventListener('click', hideExplore);

      // ─── URL HASH DETECTION FOR EXPLORE SECTION ───
      function checkExploreHash() {
        if (window.location.hash === '#explore-section') {
          const exploreSection = document.getElementById('exploreSection');
          if (exploreSection) {
            exploreSection.classList.add('visible');
            setTimeout(() => {
              exploreSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 300);
          }
        }
      }

      // Check on load
      checkExploreHash();

      // Check when hash changes
      window.addEventListener('hashchange', checkExploreHash);
    });
  </script>
</body>
</html>
